---
/**
 * CubeModel — the 3D brand mark.
 *
 * Ships as a pure-CSS/SVG cube by default (`CubeLogo`, ~1 kB inline, animates
 * on the compositor). The Three.js upgrade — 640 kB raw / 164 kB gzip once you
 * count GLTFLoader + EffectComposer + UnrealBloomPass — is a *lazy* chunk that
 * only downloads on a wide, mouse-driven, non-metered device once the cube is
 * about to enter the viewport. Phones, tablets, data-saver, low-core machines
 * and reduced-motion users never pay for it and keep the SVG.
 */
import CubeLogo from './CubeLogo.astro';
---

<div class="cube3d" data-cube3d>
  <div class="cube3d__bg" aria-hidden="true">
    <span class="cube3d__ring cube3d__ring--1"></span>
    <span class="cube3d__ring cube3d__ring--2"></span>
    <span class="cube3d__glow"></span>
    <span class="cube3d__scan" aria-hidden="true"></span>
  </div>

  <canvas class="cube3d__canvas" data-cube-canvas aria-hidden="true"></canvas>

  <div class="cube3d__fallback" data-cube-fallback>
    <CubeLogo size={220} animated decorative class="cube3d__svg" />
  </div>
</div>

<style>
  .cube3d {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .cube3d__bg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .cube3d__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .cube3d__ring--1 { width: 86%; height: 86%; }
  .cube3d__ring--2 { width: 60%; height: 60%; border-color: rgba(74, 158, 255, 0.12); }
  .cube3d__glow {
    position: absolute;
    width: 64%;
    height: 64%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(74, 158, 255, 0.32), transparent 70%);
    filter: blur(12px);
    animation: cube3d-pulse 5s ease-in-out infinite;
  }
  .cube3d__scan {
    position: absolute;
    inset: 8%;
    border-radius: 14px;
    pointer-events: none;
    opacity: 0.5;
    mix-blend-mode: screen;
    background-image:
      linear-gradient(rgba(74,158,255,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74,158,255,0.07) 1px, transparent 1px);
    background-size: 22px 22px, 22px 22px;
    -webkit-mask-image: radial-gradient(closest-side, #000 60%, transparent 100%);
            mask-image: radial-gradient(closest-side, #000 60%, transparent 100%);
  }
  .cube3d__scan::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 42%, rgba(120,190,255,0.35) 50%, transparent 58%);
    animation: cube3d-scan 3.4s linear infinite;
  }
  @keyframes cube3d-scan {
    0% { transform: translateY(-60%); opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { transform: translateY(60%); opacity: 0; }
  }
  .cube3d__canvas {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .cube3d__canvas[data-ready] { opacity: 1; }
  .cube3d__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.5s ease;
  }
  .cube3d__fallback[data-hidden] { opacity: 0; pointer-events: none; }

  /* The SVG mark carries width/height attrs for its intrinsic ratio; let it
     scale with the container so the mobile hero gets a proportional cube. */
  .cube3d :global(.cube3d__svg) {
    width: min(62%, 220px);
    height: auto;
  }

  @keyframes cube3d-pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.96); }
    50% { opacity: 0.95; transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cube3d__glow { animation: none; }
    .cube3d__scan::after { animation: none; opacity: 0; }
  }
</style>

<script>
  /**
   * Gate for the Three.js upgrade. Everything below the dynamic import stays in
   * the page's small entry chunk; `three` only leaves the server when a device
   * clears every check.
   */
  const root = document.querySelector<HTMLElement>('[data-cube3d]');

  if (root) {
    type NetInfo = { saveData?: boolean; effectiveType?: string };
    const conn = (navigator as Navigator & { connection?: NetInfo }).connection;
    const memory = (navigator as Navigator & { deviceMemory?: number }).deviceMemory;

    // A WebGL scene with bloom post-processing is a real GPU/CPU cost. Spend it
    // only where it is both visible (the hero visual is `md:` and up) and
    // affordable.
    const capable =
      window.matchMedia('(min-width: 768px) and (pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !conn?.saveData &&
      !/(^|-)2g$/.test(conn?.effectiveType ?? '') &&
      (navigator.hardwareConcurrency ?? 8) >= 4 &&
      (memory ?? 8) >= 4;

    if (capable) {
      let booted = false;
      const boot = () => {
        if (booted) return;
        booted = true;
        import('@/scripts/cube3d')
          .then((m) => m.initCube(root))
          .catch(() => { /* network/parse failure → the SVG mark stays put */ });
      };

      if ('IntersectionObserver' in window) {
        // Start fetching a little before the cube scrolls in so the swap from
        // SVG to canvas lands off-screen rather than in front of the user.
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              boot();
            }
          },
          { rootMargin: '300px' },
        );
        io.observe(root);
      } else {
        boot();
      }
    }
  }
</script>
