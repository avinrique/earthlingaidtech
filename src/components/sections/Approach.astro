---
import SectionHeading from '../SectionHeading.astro';
import { approach } from '@/data/site';
---

<section id="approach" class="relative border-y border-line bg-canvas-deep/40 py-20 md:py-24">
  <div class="container-app">
    <SectionHeading
      eyebrow="How we work"
      title="Problem first. Technology second."
      subtitle="No discovery theatre, no quarter-long roadmaps before a line of code. Here's how a project actually runs with us."
    />

    <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4" data-steps>
      {approach.map((s, i) => (
        <li
          class="reveal group relative flex flex-col rounded-2xl border border-line bg-surface/30 p-6 transition-colors duration-300 hover:border-line-strong"
          data-delay={String(i + 1)}
        >
          <span class="font-display text-4xl font-semibold tracking-tight text-accent tabular-nums" aria-hidden="true" data-step-num>{s.step}</span>
          <span class="relative mt-4 block h-px w-full bg-line">
            <span class="absolute inset-0 origin-left bg-gradient-to-r from-accent to-teal shadow-[0_0_10px_rgba(74,158,255,0.6)]" data-step-fill></span>
          </span>
          <h3 class="mt-4 text-lg">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
