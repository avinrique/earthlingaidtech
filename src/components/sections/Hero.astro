---
import CubeModel from '../CubeModel.astro';
import Button from '../Button.astro';
import { stats, site } from '@/data/site';
---

<section class="relative isolate overflow-hidden">
  <!-- Decorative background -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="bg-grid absolute inset-0 opacity-[0.5] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,black,transparent_75%)]"></div>
    <div class="glow-accent absolute -top-40 left-1/2 size-[820px] max-w-[160vw] -translate-x-1/2 opacity-60"></div>
    <div class="absolute -top-24 right-[8%] size-[420px] max-w-[90vw] rounded-full opacity-40 blur-3xl" style="background:radial-gradient(closest-side,rgba(45,212,191,0.18),transparent)"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-line-strong to-transparent"></div>
  </div>

  <!--
    Three grid children so the visual can sit between the pitch and the proof
    bar on a phone, while on lg it spans both rows as the right-hand column:
      mobile → copy / cube / stats      lg → [copy , cube]
                                              [stats,  ↑  ]
  -->
  <div class="container-app grid items-center gap-10 pt-32 pb-20 md:gap-12 md:pt-40 md:pb-28 lg:grid-cols-[1.05fr_0.95fr]">
    <!-- Copy -->
    <div class="flex flex-col items-start">
      <span class="eyebrow reveal">
        <span class="size-1.5 rounded-full bg-accent shadow-[0_0_12px_2px_rgba(74,158,255,0.6)]"></span>
        Product &amp; engineering studio · Bengaluru
      </span>

      <h1 class="reveal mt-6 text-balance font-display text-[length:var(--text-hero)] font-semibold leading-[1.03] tracking-[-0.025em] text-ink" data-delay="1">
        We build the tech<br class="hidden sm:block" />
        people actually <span class="text-gradient">use.</span>
      </h1>

      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-muted" data-delay="2">
        Web apps, AI agents, EdTech platforms, automation, and hardware — <span class="text-body">designed,
        engineered, and shipped by one team.</span> Prepzer0 already runs at SVIT and East Horizon
        School, with 600+ students trained along the way.
      </p>

      <div class="reveal mt-9 flex w-full flex-col gap-3 xs:w-auto xs:flex-row xs:flex-wrap xs:items-center" data-delay="3">
        <Button href="/products/" size="lg" iconRight="arrow-right">Explore our work</Button>
        <Button href="/contact/" size="lg" variant="secondary">Start a project</Button>
      </div>
    </div>

    <!-- Signature visual: the brand mark, SVG everywhere and WebGL where it's free -->
    <div
      class="reveal relative mx-auto w-full max-w-[15rem] sm:max-w-xs md:max-w-md lg:row-span-2 lg:max-w-none"
      data-delay="2"
    >
      <CubeModel />
    </div>

    <!-- Stat proof bar -->
    <dl class="reveal grid w-full max-w-lg grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-8 sm:grid-cols-4" data-delay="4">
      {stats.map((s) => (
        <div class="flex flex-col gap-1">
          <dt class="order-2 text-xs text-faint">{s.label}</dt>
          <dd class="order-1 font-display text-2xl font-semibold text-ink">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
