---
import { Icon } from 'astro-icon/components';
import SectionHeading from '../SectionHeading.astro';
import { techBuild, techRun } from '@/data/site';

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;

// Two identical halves so translateX(-50%) loops seamlessly; the clone is
// aria-hidden so screen readers hear each tool once, not twice.
const rows = [
  { items: techBuild, anim: 'animate-[marquee_44s_linear_infinite]' },
  { items: techRun, anim: 'animate-[marquee_52s_linear_infinite_reverse]' },
];
---

<section class="py-20 md:py-28">
  <div class="container-app">
    {heading && (
      <SectionHeading
        eyebrow="Our stack"
        title="Built on tools <span class='text-accent'>we trust</span>"
        subtitle="The frameworks, clouds, databases, and AI models we ship with every week — the same stack we use to build and to teach."
      />
    )}
  </div>

  <div class:list={['flex flex-col gap-5', heading ? 'mt-14' : 'mt-2']}>
    {rows.map((row) => (
      <div class="group relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
        <div data-marquee class:list={['flex w-max group-hover:[animation-play-state:paused]', row.anim]}>
          {[false, true].map((isClone) => (
            <ul class="flex shrink-0 list-none items-center gap-4 pr-4" aria-hidden={isClone ? 'true' : undefined}>
              {row.items.map((t) => (
                <li class="flex shrink-0 items-center gap-3 rounded-2xl border border-line bg-surface/40 px-5 py-3.5 transition-colors duration-300 hover:border-line-strong hover:bg-surface-2/60">
                  <Icon name={`simple-icons:${t.icon}`} class="size-6 text-muted" aria-hidden="true" />
                  <span class="font-display text-base font-medium text-body">{t.name}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
