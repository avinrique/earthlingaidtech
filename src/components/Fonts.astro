---
/**
 * Fonts — self-hosted variable fonts, hand-declared instead of importing the
 * Fontsource entrypoints.
 *
 * Why not `import '@fontsource-variable/inter'`? That pulls EVERY subset
 * (cyrillic, cyrillic-ext, greek, greek-ext, vietnamese, latin-ext, latin) for
 * every family — 15 woff2 files / 364 kB in the build — and gives us no way to
 * preload the hashed URLs. The site is English-only, so we ship latin (+ a
 * latin-ext that only downloads if an accented glyph actually appears) and
 * preload the two faces that paint above the fold.
 *
 * `?url` runs the file through Vite so it lands in _astro/ with a content hash
 * and a far-future cache header, exactly like the Fontsource import did.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import groteskLatinExt from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-ext-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
---

{/* Body + display faces paint above the fold on every route — fetch them in parallel with the CSS. */}
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />

<style
  is:global
  set:html={`
@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${interLatin}) format('woff2-variations');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${interLatinExt}) format('woff2-variations');
  unicode-range: ${LATIN_EXT};
}
@font-face {
  font-family: 'Space Grotesk Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 300 700;
  src: url(${groteskLatin}) format('woff2-variations');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Space Grotesk Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 300 700;
  src: url(${groteskLatinExt}) format('woff2-variations');
  unicode-range: ${LATIN_EXT};
}
@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url(${monoLatin}) format('woff2-variations');
  unicode-range: ${LATIN};
}

/* Metric-matched Arial stand-in for Inter. Sized so the swap from fallback to
   the real face does not reflow the paragraph — this is the CLS fix, and it is
   why --font-sans lists "Inter Fallback" ahead of the generic stack. */
@font-face {
  font-family: 'Inter Fallback';
  src: local('Arial');
  size-adjust: 107.12%;
  ascent-override: 90.44%;
  descent-override: 22.52%;
  line-gap-override: 0%;
}
`}
/>
