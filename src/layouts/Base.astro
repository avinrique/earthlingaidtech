---
import '@/styles/global.css';

import Fonts from '@/components/Fonts.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /** Extra JSON-LD nodes merged into the page's @graph (Product, Course, …). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogImage = '/og.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = `${site.name} — ${site.tagline}`,
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
// Always canonicalise to the trailing-slash form — that is what GitHub Pages
// actually serves; the bare path 301-redirects to it.
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

// Stable @ids so Product/Course/Breadcrumb nodes on individual pages can point
// at one canonical Organization instead of each page re-declaring an anonymous
// copy of it.
const ORG_ID = `${site.url}/#organization`;
const SITE_ID = `${site.url}/#website`;

const orgNode = {
  '@type': 'Organization',
  '@id': ORG_ID,
  // `name` is what a knowledge panel shows — that should be the brand people
  // search for, with the registrar string kept as the legal name.
  name: site.name,
  legalName: site.legalName,
  alternateName: [site.shortName, site.legalName],
  url: site.url,
  logo: {
    '@type': 'ImageObject',
    url: `${site.url}/og.png`,
    width: 1200,
    height: 630,
  },
  image: `${site.url}/og.png`,
  description: site.description,
  foundingDate: site.founded,
  email: site.email,
  identifier: site.registrationNo,
  sameAs: [site.social.github],
  address: [
    {
      '@type': 'PostalAddress',
      streetAddress: 'Biratnagar Metropolitan City-6',
      addressLocality: 'Biratnagar',
      addressRegion: 'Morang, Province No. 1',
      addressCountry: 'NP',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: 'BMSIT BICEP',
      addressLocality: 'Bengaluru',
      addressRegion: 'Karnataka',
      addressCountry: 'IN',
    },
  ],
  slogan: site.tagline,
};

const siteNode = {
  '@type': 'WebSite',
  '@id': SITE_ID,
  url: site.url,
  name: site.name,
  description: site.description,
  publisher: { '@id': ORG_ID },
  inLanguage: 'en',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [orgNode, siteNode, ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/* Arms the scroll-reveal styles before first paint. Everything stays
        visible if this never runs — see the `.js .reveal` rules in global.css. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <Fonts />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-apple.png" />
    {/* A noindex page (the 404, served for every unknown URL) must not declare a
        canonical — `/404/` does not exist, and pairing noindex with a canonical
        risks the noindex being carried to the target. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B0D10" />
    <meta name="color-scheme" content="dark" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-on-accent"
    >
      Skip to content
    </a>

    <div class="grain" aria-hidden="true"></div>

    <Header />

    {/* tabindex="-1" so the skip link actually moves focus. Without it Safari
        scrolls to #main but leaves focus in the header, and the next Tab drops
        the user back at the top of the nav. */}
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <Footer />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasIO = 'IntersectionObserver' in window;

      // ---- Scroll-reveal: progressively show .reveal elements as they enter view.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce || !hasIO) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              obs.unobserve(el);
              // Promote for the duration of the transition only. A permanent
              // will-change would keep a compositor layer alive for every
              // revealed element on the page.
              el.style.willChange = 'opacity, transform';
              el.classList.add('is-visible');
              el.addEventListener(
                'transitionend',
                () => { el.style.willChange = ''; },
                { once: true },
              );
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      }

      // ---- Marquees: an infinite animation off-screen still burns compositor
      // frames (and battery). Park each row while it is out of view.
      const marquees = document.querySelectorAll<HTMLElement>('[data-marquee]');
      if (marquees.length && hasIO && !reduce) {
        const mio = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.toggleAttribute('data-paused', !entry.isIntersecting);
            });
          },
          { rootMargin: '150px' },
        );
        marquees.forEach((el) => mio.observe(el));
      }
    </script>
  </body>
</html>
