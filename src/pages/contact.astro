---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import LeadForm from '@/components/LeadForm.astro';
import { Icon } from 'astro-icon/components';
import { services, site } from '@/data/site';

const subject = encodeURIComponent('Project enquiry — Earthling Aidtech');
const body = encodeURIComponent(
  'Hi Earthling Aidtech team,\n\nWe’d like to talk about a project.\n\n• Organization:\n• What we need:\n• Timeline:\n\nThanks,',
);
const mailto = `mailto:${site.email}?subject=${subject}&body=${body}`;
---

<Base
  title="Contact"
  description="Let's build intelligent systems that matter. Partner with Earthling Aidtech on products, platforms, and experiences driven by intelligence and impact."
>
  <PageHeader
    eyebrow="Contact"
    title="Let's build <span class='text-gradient'>intelligent systems</span> that matter"
    subtitle="Tell us about your institution, organization, or product. We'll get back to you with a practical, execution-focused plan."
  />

  <section class="py-16 md:py-24">
    <div class="container-app grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <!-- Left: the enquiry form — the primary action on this page. -->
      <LeadForm class="reveal" />

      <!-- Right: the secondary routes in — direct email, and where we are. -->
      <aside class="flex flex-col gap-4">
        <a
          href={mailto}
          class="reveal group flex flex-col rounded-2xl border border-line bg-surface/30 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-line-strong"
          data-delay="1"
        >
          <Icon name="lucide:mail" class="size-6 text-accent" aria-hidden="true" />
          <h2 class="mt-4 text-base">Prefer email?</h2>
          <p class="mt-1 text-sm text-muted">
            Same inbox, same people. Best when you have a brief or documents to attach.
          </p>
          {/* `break-all` + wrap: the address is 29 characters and does not
              fit one line inside this card below ~360px. */}
          <span class="mt-3 inline-flex flex-wrap items-center gap-2 break-all text-sm font-medium text-accent">
            {site.email}
            <Icon name="lucide:arrow-up-right" class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
          </span>
        </a>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          <a
            href={`mailto:${site.emailAlt}`}
            class="reveal group flex flex-col rounded-2xl border border-line bg-surface/30 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-line-strong"
            data-delay="2"
          >
            <Icon name="lucide:inbox" class="size-6 text-teal" aria-hidden="true" />
            <h3 class="mt-4 text-base">General enquiries</h3>
            <span class="mt-1 break-all text-sm text-faint transition-colors group-hover:text-body">{site.emailAlt}</span>
          </a>

          <div class="reveal flex flex-col rounded-2xl border border-line bg-surface/30 p-6" data-delay="3">
            <Icon name="lucide:map-pin" class="size-6 text-violet" aria-hidden="true" />
            <h3 class="mt-4 text-base">Locations</h3>
            <div class="mt-2 flex flex-col gap-3">
              {site.offices.map((office) => (
                <p class="text-sm leading-relaxed">
                  <span class="block font-medium text-body">{office.label}</span>
                  <span class="text-faint">{office.address}</span>
                </p>
              ))}
            </div>
          </div>
        </div>

        <!-- What we can help with -->
        <div class="reveal flex flex-col rounded-2xl border border-line bg-surface/30 p-6" data-delay="4">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-faint">How we can help</p>
          <ul class="mt-4 flex flex-col divide-y divide-line">
            {services.map((s) => (
              <li class="flex items-center gap-3 py-3">
                <Icon name={`lucide:${s.icon}`} class="size-5 shrink-0 text-accent" aria-hidden="true" />
                <span class="text-sm text-body">{s.title}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>
