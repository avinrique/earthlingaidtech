# Backend environment. Copy to .env.local for local `vercel dev`, or set in the Vercel dashboard.
# NOTHING in this file may be committed with a real value.

# --- database -----------------------------------------------------------------
# Injected automatically by the Neon integration (`vercel integration add neon`).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- email --------------------------------------------------------------------
# The existing services@earthlingaidtech.com mailbox that `eatmail` already uses.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=services@earthlingaidtech.com
# SECRET. Lives at mode 600 in ~/.eat-mailer/config.json. Add it with
#   vercel env add SMTP_PASS production
# so it is never echoed into shell history.
SMTP_PASS=
MAIL_FROM=Earthling Aidtech <services@earthlingaidtech.com>

# Where new-lead notifications land. Comma-separated for more than one.
LEAD_NOTIFY_TO=avigupta2001ad@gmail.com

# --- admin --------------------------------------------------------------------
# SECRET. The single password for the lead dashboard. Make it long.
ADMIN_PASSWORD=
# SECRET. Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Salt for hashing visitor IPs. Rotating it just resets rate-limit buckets.
IP_SALT=

# --- cors ---------------------------------------------------------------------
# Exactly the origins the marketing site is served from. No wildcards: the API
# allows credentials, so a reflected origin would expose authenticated responses.
ALLOWED_ORIGINS=https://earthlingaidtech.com,https://www.earthlingaidtech.com
